# ============================================
# GENERAL CONFIG
# ============================================
BASE_DIR=D:\File01\DATA

# PROCESS_MODE:
#   ordered = chạy tuần tự 1 process (đời cũ)
#   stream  = đọc tới đâu xử lý tới đó (1 process)
#   multi   = CHA đẻ nhiều process con, chạy song song an toàn
PROCESS_MODE=multi

# Số process con chạy song song (mỗi process 1 folder)
# Bạn có 32 logical cores → nên chọn 8–12
PROCESSES=10

# Mỗi process dùng bao nhiêu thread để resize ảnh
# Do libvips thread-unsafe → nên đặt 1 hoặc 2
THREADS_PER_PROCESS=1
VIPS_CONCURRENCY=1 
VIPS_CACHE_MAX=0
# Batch size mỗi worker. 16 hoặc 32 là tối ưu
BATCH_SIZE=16

# Target resolution
RESIZE_WIDTH=1216
RESIZE_HEIGHT=1040

QUALITY=65
VERBOSE=false

SKIP_SAME_RESOLUTION=false

# Process all subfolders in multi mode, even if they don't match YYYY/MM/DD format.
# false (default) = only process folders matching YYYY/MM/DD pattern in multi mode
# true  = process all subfolders in multi/ordered modes, maintaining sort order by date if applicable
PROCESS_ALL_FOLDERS=false

# Comma-separated list of filename prefixes (case-insensitive) to consider for resizing.
# Default includes the legacy prefixes. Leave empty to process all images.
IMAGE_PREFIXES=Full_,Vehicle_

# ============================================
# LOGGING
# ============================================
LOG_FILE=D:\ImageResize\resize.log
RESIZE_HISTORY_LOG=D:\ImageResize\resize_history.log
LOG_MAX_MB=300

# ============================================
# IMAGE PROCESS CONTROL
# ============================================
IMAGE_TIMEOUT_SEC=20
IMAGE_RETRY=2

# ============================================
# SCHEDULER CONFIG
# ============================================
ENABLE_SCHEDULER=true
SCHEDULE_HOUR=2
SCHEDULE_MINUTE=0
SCHEDULER_LAST_N_DAYS=8

# Dry-run mode: if true the tool will only log actions and won't write or spawn children.
# Set to true to validate behavior without making changes.
DRY_RUN=false
